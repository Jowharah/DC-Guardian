# Private biometric image data - NEVER COMMIT
phase1/face_recognition/data/controlled_faces/
phase1/face_recognition/data/raw/

# Generated/processed biometric data
phase1/face_recognition/data/processed/

# Biometric enrollment embeddings - NEVER COMMIT
