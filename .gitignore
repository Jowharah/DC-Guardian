# ============================================================
# PHASE 1 - PREDICTIVE MAINTENANCE
# ============================================================

# Backblaze raw datasets
phase1/predictive_maintenance/data/raw/

# Large generated / processed datasets
phase1/predictive_maintenance/data/processed/**/*.parquet
phase1/predictive_maintenance/data/processed/**/*.csv
phase1/predictive_maintenance/data/processed/**/*.npy
phase1/predictive_maintenance/data/processed/**/*.npz

# Keep JSON evaluation/configuration artifacts.
# Keep frozen models.
#
# temporal_rf_v2.joblib is intentionally NOT ignored.
