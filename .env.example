# DC-GUARDIAN local configuration template
# Copy to .env at the repository root and fill values locally.
# Never commit .env or real credentials.

NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
OPENAI_API_KEY=

# DC-GUARDIAN local dashboard authentication
DCG_LOCAL_USER=
DCG_LOCAL_PASSWORD=
DCG_LOCAL_ROLE=
DCG_LOCAL_ZONES=

# OpenAI Investigator (disabled by default; set to 1 only after data approval)
DCG_INVESTIGATOR_ENABLED=0
DCG_INVESTIGATOR_MODEL=
