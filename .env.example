# DC-GUARDIAN local configuration template
# Copy to .env at the repository root and fill values locally.
# Never commit .env or real credentials.

# On Windows use bolt://127.0.0.1:7687 rather than localhost (avoids a ~2 s delay per connection).
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
OPENAI_API_KEY=

# DC-GUARDIAN local dashboard authentication
DCG_LOCAL_USER=
DCG_LOCAL_PASSWORD=
DCG_LOCAL_ROLE=
DCG_LOCAL_ZONES=

# OpenAI Investigator (disabled by default; set to 1 only after data approval)
DCG_INVESTIGATOR_ENABLED=0
DCG_INVESTIGATOR_MODEL=
# Post-generation overclaim check (one extra short call per answer; on by default when enabled)
# DCG_INVESTIGATOR_JUDGE_ENABLED=1
# DCG_INVESTIGATOR_JUDGE_MODEL=
# Per-user limit on OpenAI-backed calls (Investigator questions and specialist evaluations)
# DCG_OPENAI_CALLS_PER_MINUTE=10
# Key for Investigator pseudonyms (default: random per-install key in the data folder)
# DCG_PSEUDONYM_SALT=

# Optional private Investigator history (plaintext local SQLite, test data only)
DCG_INVESTIGATOR_HISTORY_ENABLED=0
DCG_INVESTIGATOR_HISTORY_DAYS=7

# Optional overrides (defaults: <repo>/logs and presentation/backend/data/incidents.sqlite3)
# DCG_LOG_DIR=
# DCG_PRESENTATION_DB=
